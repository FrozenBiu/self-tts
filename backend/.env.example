# ==============================================================================
# CẤU HÌNH HỆ THỐNG VOXCPM2 TTS
# 
# Hướng dẫn: Đổi tên file này thành `.env` để cấu hình có hiệu lực.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TỐI ƯU HOÁ BỘ NHỚ VRAM (Dành cho tính toán AI)
# ------------------------------------------------------------------------------
# Mô hình AI đòi hỏi bộ nhớ của card đồ hoạ (VRAM) để hoạt động nhanh nhất. 
# Nếu máy tính của bạn bị lỗi "CUDA Out Of Memory", hãy điều chỉnh thông số dưới đây.

# Ép hệ thống dùng độ chính xác một nửa (FP16/Half Precision) để giảm VRAM xuống 1/2.
# - Nếu VRAM <= 4GB (VD: GTX 1650, 1050Ti): Bắt buộc để True
# - Nếu VRAM 6GB - 8GB: Nên để True
# - Nếu VRAM >= 12GB (VD: RTX 3060 12GB, RTX 4090): Để False để giữ độ chính xác cao nhất
VOXCPM_HALF_PRECISION=True

# Tải bộ lọc nhiễu âm thanh (Denoiser) vào VRAM
# - Nếu VRAM <= 8GB: Bắt buộc để False
# - Nếu VRAM >= 12GB: Để True để khử nhiễu môi trường tốt hơn
VOXCPM_LOAD_DENOISER=False

# Ép hệ thống bỏ qua card đồ hoạ và chỉ dùng CPU (Dành cho máy bị nghẽn VRAM nghiêm trọng)
# - Nếu bạn dùng card 4GB và bị chậm tới mức 10 phút, hãy thử để True.
# - CPU sẽ xử lý trực tiếp trên RAM máy tính, tránh thắt cổ chai truyền tải.
VOXCPM_FORCE_CPU=False


# ------------------------------------------------------------------------------
# 2. CẤU HÌNH MẶC ĐỊNH CHO CHẤT LƯỢNG ÂM THANH
# ------------------------------------------------------------------------------
# Số bước khử nhiễu để tạo ra âm thanh (inference timesteps). 
# Số càng cao thì AI suy luận càng kỹ -> giọng càng thật, nhưng sinh càng lâu và tốn máy.
# - Máy rất yếu (CPU / VRAM thấp): 4 - 6
# - Mức tiêu chuẩn: 10
# - Mức cao (Chất lượng rất tốt): 20 - 30
DEFAULT_INFERENCE_TIMESTEPS=10

# ------------------------------------------------------------------------------
# 3. LUA CHON MO HINH (MODEL SELECTION)
# ------------------------------------------------------------------------------
# Chon mo hinh ban muon he thong tai vao VRAM:
# - "2"   : Mo hinh goc (openbmb/VoxCPM2) - Doi hoi nhieu VRAM
# - "1.5" : Mo hinh rut gon (JayLL13/VoxCPM-1.5-VN) - Rat nhe, toi uu tieng Viet tot
VOXCPM_MODEL_VERSION=1.5
