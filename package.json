{
  "name": "omnivoice-studio-desktop",
  "version": "1.0.0",
  "description": "OmniVoice Studio - Ứng dụng Text-to-Speech Chuyên Nghiệp 24kHz",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "desktop:start": "node electron/start.cjs",
    "desktop:dev": "node electron/dev-runner.cjs",
    "desktop:pack": "pnpm --filter frontend build && node electron/customize-exe.cjs && electron-builder --dir",
    "desktop:pack:mac": "pnpm --filter frontend build && node electron/customize-exe.cjs && electron-builder --mac --dir",
    "desktop:build": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false pnpm --filter frontend build && node electron/customize-exe.cjs && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "desktop:build:mac": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false pnpm --filter frontend build && node electron/customize-exe.cjs && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac -p never",
    "build:frontend": "pnpm --filter frontend build"
  },
  "keywords": [
    "tts",
    "omnivoice",
    "electron",
    "react",
    "voice-cloning"
  ],
  "author": "OmniVoice Team",
  "license": "AGPL-3.0",
  "build": {
    "appId": "com.omnivoice.studio",
    "productName": "OmniVoice Studio",
    "forceCodeSigning": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!.env",
          "!venv/**/*",
          "!outputs/**/*",
          "!local_models/**/*",
          "!__pycache__/**/*"
        ]
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "win": {
      "icon": "assets/app.ico",
      "signExecutable": false,
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "python_runtime",
          "to": "python"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OmniVoice Studio",
      "installerIcon": "assets/app.ico",
      "uninstallerIcon": "assets/app.ico",
      "installerHeaderIcon": "assets/app.ico"
    },
    "mac": {
      "icon": "assets/app.png",
      "category": "public.app-category.utilities",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "OmniVoice Studio",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "rcedit": "^5.0.2",
    "tree-kill": "^1.2.2",
    "wait-on": "^9.1.0"
  }
}
